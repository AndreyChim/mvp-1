<%= user_tab_component(name: :details, text: "User Details", current: true) %>

<div class="user-details">
  <h2 class="text-2xl font-semibold"><%= @user.email %></h2>
  <p class="mt-2 text-gray-600">
    Registered at: <%= l(@user.created_at, format: :long) %>
  </p>
</div>

<div class="mt-6 flex gap-3">
  <%= render Educhain::Button::Component.new(
    tag: :a,
    text: "Edit",
    href: edit_user_path(@user),
    scheme: :secondary
  ) %>

  <%= render Educhain::Button::Component.new(
    tag: :a,
    text: "Back",
    href: users_path,
    scheme: :secondary
  ) %>
</div>