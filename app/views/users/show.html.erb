<div class="flex min-h-screen">
  <div class="fixed inset-y-0 left-0 w-64 border-r bg-gray-50">
    <%= navigtion_component %>
  </div>
  <div class="flex-1 ml-64">
    <%= page do %>
      <%= page_header do %>
        <%= page_header_title("User details") %>
      <% end %>
      <%= page_with_sidebar do %>
        <div class="mt-4">
          <%= page_with_sidebar_main do %>
            <div class="user-details">
              <h2 class="text-2xl font-semibold"><%= @user.email %></h2>
              <p class="mt-2 text-gray-600">
                Registered at: <%= l(@user.created_at, format: :long) %>
              </p>
            </div>
          </div>
          <div class="mt-6 flex gap-3">
            <%= render Educhain::Button::Component.new(
          tag: :a,
          text: "Edit",
          href: edit_user_path(@user),
          scheme: :secondary
          ) %>
            <%= render Educhain::Button::Component.new(
          tag: :a,
          text: "Back",
          href: users_path,
          scheme: :secondary
          ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>