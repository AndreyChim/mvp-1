<%= user_tab_component(text: "All Users", current: true) if current_user.admin? %>

<%= render Educhain::Table::Component.new(
  id: 'users-table',
  data: {
    rows: @users,
    class: User,
    columns: [
      { header: 'Email', data: :email },
      {
        header: 'Actions',
        data: ->(user) { link_to('Show', user_path(user)) }
      }
    ]
  }
) %>