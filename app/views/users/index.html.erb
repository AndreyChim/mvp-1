<%= user_tab_component(
  text: content_tag(:span, "All Users", class: "text-2xl"), 
  current: true,
  class: "mb-6"
) %>

<%= render Educhain::Table::Component.new(
  id: 'users-table',
  data: {
    rows: @users,
    class: User,
    columns: [
      { header: 'Email', data: :email },
      {
        header: 'Actions',
        data: ->(user) { link_to('Show', user_path(user)) }
      }
    ]
  }
) %>