<div class="fixed inset-y-0 left-0 w-64 border-r bg-gray-50 flex flex-col">
  
  <div class="flex-1 overflow-y-auto">
    <%= navigation_component %>
  </div>

  <div class="p-4">
    <div class="text-sm font-medium text-gray-700">
      <%= render Educhain::Navigation::Account::Component.new(
      user_label: current_user.email,
      account_path: "#",
      logout_path: "#",
      logout_method: :delete,
    ) %>
    </div>
  </div>
</div>

<div class="flex-1 ml-64">
  <%= page do %>
    <div class="w-full shadow-sm">
   
  <%= page_with_sidebar do %>
    <div class="mt-4">
      <%= page_with_sidebar_main do %>
        <%= render Educhain::Table::Component.new(
            id: 'users-table',
            data: {
              rows: @users,
              class: User,
              columns: [
                { header: 'Email', data: :email },
                {
                  header: 'Actions',
                  data: ->(user) { link_to('Show', user_path(user), class: "text-blue-600 hover:underline") }
                }
              ]
            }
          ) %>
    </div>
    <% end %>
    
      <%= page_with_sidebar_aside do %>
        <div class="p-4 bg-white rounded-lg shadow">
          <h3 class="font-semibold mb-2">Quick Stats</h3>
          <p class="text-gray-600"><%= @users.count %> total users</p>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
