<div class="flex min-h-screen">
  <div class="fixed inset-y-0 left-0 w-64 border-r bg-gray-50">
    <%= navigtion_component %>
  </div>
  <div class="flex-1 ml-64">
    <%= page do %>
      <%= page_header do %>
        <%= page_header_title("Edit User") %>
      <% end %>
      <%= page_with_sidebar do %>
        <div class="mt-4">
          <%= page_with_sidebar_main do %>
            <%= render 'form', user: @user %>
            <div class="mt-6 flex gap-3">
              <%= render Educhain::Button::Component.new(
              tag: :a,
              text: "Show",
              href: user_path(@user),
              scheme: :secondary
            ) %>
              <%= render Educhain::Button::Component.new(
              tag: :a,
              text: "Back",
              href: users_path,
              scheme: :secondary
            ) %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
