<%= user_tab_component(
  text: content_tag(:span, "Edit User", class: "text-2xl"), 
  current: true,
  class: "mb-6"
) %>

<%= render 'form', user: @user %>

<div class="mt-6 flex gap-3">
  <%= render Educhain::Button::Component.new(
    tag: :a,
    text: "Show",
    href: user_path(@user),
    scheme: :secondary
  ) %>

  <%= render Educhain::Button::Component.new(
    tag: :a,
    text: "Back",
    href: users_path,
    scheme: :secondary
  ) %>
</div>