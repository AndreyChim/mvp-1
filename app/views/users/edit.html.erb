<%= user_tab_component(text: "Edit User", current: true) %>

<%= render 'form', user: @user %>

<div class="mt-6 flex gap-3">
  <%= render Educhain::Button::Component.new(
    tag: :a,
    text: "Show",
    href: user_path(@user),
    scheme: :secondary
  ) %>

  <%= render Educhain::Button::Component.new(
    tag: :a,
    text: "Back",
    href: users_path,
    scheme: :secondary
  ) %>
</div>