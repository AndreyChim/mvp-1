<div class="flex min-h-screen">
  <div class="fixed inset-y-0 left-0 w-64 border-r bg-gray-50">
    <%= navigation_component %>
  </div>
  <div class="flex-1 ml-64">
    <%= page do %>
      <%= page_header do %>
        <%= page_header_actions do %>
          <%= link_to users_path, 
              class: "bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-colors inline-flex items-center",
              aria: { label: "Back" } do %>
            <%= render Educhain::Icon::Component.new(
          name: "arrow-left-line",
          class: "w-5 h-5"
        ) %>
          <% end %>
        <% end %>
        <div class="ml-4">
          <%= page_header_title("Edit User") %>
        </div>
      <% end %>
      <%= page_with_sidebar do %>
        <div class="mt-4">
          <%= page_with_sidebar_main do %>
            <%= render 'form', user: @user %>
            <div class="mt-6 flex gap-3">
              <%= render Educhain::Button::Component.new(
              tag: :a,
              size: :l,
              text: "Show",
              href: user_path(@user),
              scheme: :secondary
            ) %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
